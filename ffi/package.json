{
  "name": "@noita-ts/ffi",
  "version": "0.5.0",
  "author": "Anton Bulakh <him@necauq.ua> (https://necauq.ua/)",
  "files": [
    "dist/*.{lua,d.ts}",
    "hde32.dll"
  ],
  "type": "module",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index"
    },
    "./cpp": {
      "types": "./dist/cpp.d.ts",
      "default": "./dist/cpp"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema"
    },
    "./magic-numbers": {
      "types": "./dist/magic-numbers.d.ts",
      "default": "./dist/magic-numbers"
    },
    "./game-global": {
      "types": "./dist/game-global.d.ts",
      "default": "./dist/game-global"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform"
    },
    "./global-stats": {
      "types": "./dist/global-stats.d.ts",
      "default": "./dist/global-stats"
    },
    "./death-match": {
      "types": "./dist/death-match.d.ts",
      "default": "./dist/death-match"
    },
    "./entity-manager": {
      "types": "./dist/entity-manager.d.ts",
      "default": "./dist/entity-manager"
    },
    "./luajit": {
      "types": "./dist/luajit.d.ts",
      "default": "./dist/luajit"
    }
  },
  "scripts": {
    "prepublishOnly": "rm -rf dist && npm run build",
    "build": "npm run build:lua && npm run build:hde32",
    "build:hde32": "docker build --output . hde32",
    "build:lua": "tstl -p . && cp src/*.{lua,d.ts} dist/"
  },
  "dependencies": {
    "@noita-ts/base": "^0.9.4",
    "@typescript-to-lua/language-extensions": "^1.19.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
