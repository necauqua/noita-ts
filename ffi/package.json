{
  "name": "@noita-ts/ffi",
  "version": "0.3.0",
  "author": "Anton Bulakh <him@necauq.ua> (https://necauq.ua/)",
  "files": [
    "**/*.{lua,d.ts}",
    "hde32.dll",
    "asm-plugin.js",
    "nasm/*.mjs",
    "nasm/reloc.asm",
    "nasm/nasm",
    "nasm/nasm.exe"
  ],
  "type": "module",
  "main": "src/index",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index"
    },
    "./global_stats": {
      "types": "./src/global_stats.d.ts",
      "default": "./src/global_stats"
    },
    "./asm-plugin": {
      "default": "./nasm/asm-plugin.mjs"
    },
    "./asm": {
      "types": "./nasm/asm.d.ts"
    }
  },
  "scripts": {
    "prepublishOnly": "docker build --output . hde32 && tsc -p ."
  },
  "dependencies": {
    "@types/noita-ffi-asm": "file:../ffi-asm-types",
    "@typescript-to-lua/language-extensions": "^1.19.0"
  },
  "peerDependencies": {
    "typescript-to-lua": ">=1.36.0"
  },
  "peerDependenciesMeta": {
    "typescript-to-lua": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
