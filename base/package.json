{
  "name": "@noita-ts/base",
  "version": "0.8.1",
  "author": "Anton Bulakh <him@necauq.ua> (https://necauq.ua/)",
  "files": [
    "dist/**/*.{js,lua,d.ts}",
    "types/*.d.ts",
    "types/generated/*.d.ts",
    "mod-tsconfig.json"
  ],
  "type": "module",
  "main": "dist/index",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index"
    },
    "./mod-tsconfig.json": {
      "default": "./mod-tsconfig.json"
    },
    "./types": {
      "types": "./types/index.d.ts"
    },
    "./json": {
      "default": "./dist/json"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "default": "./dist/async"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test"
    }
  },
  "bin": {
    "nts": "dist/bin/index.js"
  },
  "scripts": {
    "prepublishOnly": "rm -rf dist && npm run typegen && npm run build",
    "build": "npm run build:lua && npm run build:bin && npm run build:noita-api",
    "build:lua": "tstl -p . && cp src/*.lua dist/ && sed -i '1i /// <reference types=\"@noita-ts/base/types\" />' dist/index.d.ts dist/test.d.ts",
    "build:noita-api": "test -f dist/noita.d.lua || curl -Lo dist/noita.d.lua https://raw.githubusercontent.com/NathanSnail/AutoLuaAPI/c8947a4977cff16148a7e7f574721b5decaf2463/out.lua",
    "build:bin": "tsc -p ./tsconfig.bin.json",
    "typegen": "npm run typegen:api && npm run typegen:components",
    "typegen:api": "tsx types/bin/main.ts lua types/bin/lua_api_documentation.txt -f types/fixups.d.ts -o types/generated/lua_api.d.ts",
    "typegen:components": "tsx types/bin/main.ts components -i types/bin/component_documentation.txt -o types/generated/components.d.ts"
  },
  "dependencies": {
    "@typescript-to-lua/language-extensions": "^1.19.0",
    "archiver": "^7.0.1",
    "commander": "^14.0.2",
    "jsonc-parser": "^3.3.1",
    "lua-types": "^2.13.1",
    "steam-locate": "^1.0.6",
    "sync-directory": "^6.0.5",
    "typescript": "^6.0.2",
    "typescript-to-lua": "^1.36.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6"
  }
}
