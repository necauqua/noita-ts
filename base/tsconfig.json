{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "bundler",
    "types": ["noita-ts"],
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
  },
  "include": ["src"],
  "tstl": {
    "buildMode": "library",
    "noResolvePaths": ["$mod"],
    "luaTarget": "JIT",
    "noImplicitSelf": true,
  },
}
